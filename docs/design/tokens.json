{
  "$description": "Investigate design tokens, T-010, extended by T-034 (zoom and pan: groups zoom, zoomLayout, zoomInteraction, deepGrid, cursor). Format follows the W3C Design Tokens Community Group draft ($value, $type). All sizes are logical pixels at 100 % scale. Colours are opaque sRGB hex unless an alpha is given separately. Source of truth for source/gui/DesignTokens.h.",
  "meta": {
    "version": { "$type": "string", "$value": "1.1.0" },
    "date": { "$type": "string", "$value": "2026-10-03" }
  },
  "color": {
    "bg-app":        { "$type": "color", "$value": "#0E1219", "$description": "Header and footer bar background" },
    "bg-plot":       { "$type": "color", "$value": "#0A0D13", "$description": "Spectrum plot region, meter tracks, darkest surface" },
    "surface":       { "$type": "color", "$value": "#131924", "$description": "Meter strip, popover, menus" },
    "surface-2":     { "$type": "color", "$value": "#1A2130", "$description": "Chip and button fill, segmented-control track" },
    "surface-3":     { "$type": "color", "$value": "#232C3E", "$description": "Hover fill, tooltip fill" },
    "card":          { "$type": "color", "$value": "#151B27", "$description": "Hover readout card fill" },
    "border":        { "$type": "color", "$value": "#2A3447", "$description": "Region separators, popover border, card border" },
    "border-subtle": { "$type": "color", "$value": "#1A2130", "$description": "Plot data-rect frame, meter track outline" },
    "grid-minor":    { "$type": "color", "$value": "#161D2A", "$description": "Unlabelled frequency lines, dB lines" },
    "grid-major":    { "$type": "color", "$value": "#243047", "$description": "Decade frequency lines, 0 dB line" },
    "text-primary":  { "$type": "color", "$value": "#E8ECF3", "$description": "Values, readouts" },
    "text-secondary":{ "$type": "color", "$value": "#A3AEC2", "$description": "Labels, units, legend" },
    "text-tertiary": { "$type": "color", "$value": "#75829A", "$description": "Axis labels, section titles" },
    "text-disabled": { "$type": "color", "$value": "#4A5468", "$description": "Inactive state only (WCAG-exempt)" },
    "text-on-accent":{ "$type": "color", "$value": "#0A0D13", "$description": "Text on accent, frozen and clip fills" },
    "accent":        { "$type": "color", "$value": "#62D6F0", "$description": "Selected segment, active toggle, focus ring, drag highlight" },
    "accent-tint":   { "$type": "color", "$value": "#1B313B", "$description": "Active toggle fill (accent 16 % over bg-app, pre-blended)" },
    "state-frozen":  { "$type": "color", "$value": "#8FB8FF", "$description": "Freeze active: button, badge, plot frame" },
    "state-frozen-tint": { "$type": "color", "$value": "#283347", "$description": "Freeze button fill when active (state-frozen 20 % over bg-app, pre-blended)" },
    "state-warn":    { "$type": "color", "$value": "#EAC75A", "$description": "Clamped effective range values" },
    "state-error":   { "$type": "color", "$value": "#FF4F64", "$description": "Invalid text entry flash, negative headroom text" }
  },
  "curve": {
    "primary-a":   { "stroke": { "$type": "color", "$value": "#62D6F0" }, "strokeWidth": { "$type": "dimension", "$value": 1.5 }, "fill": { "$type": "gradient", "$value": { "colour": "#62D6F0", "alphaTop": 0.30, "alphaBottom": 0.04 } }, "$description": "Primary curve, and first curve of dual modes (L or M). Line plus vertical gradient fill." },
    "primary-b":   { "stroke": { "$type": "color", "$value": "#FFB454" }, "strokeWidth": { "$type": "dimension", "$value": 1.5 }, "fill": { "$type": "string", "$value": "none" }, "$description": "Second curve of dual modes (R or S). Line only." },
    "secondary-a": { "stroke": { "$type": "color", "$value": "#3E8FA3" }, "strokeWidth": { "$type": "dimension", "$value": 1.0 }, "fill": { "$type": "string", "$value": "none" }, "$description": "Secondary curve for primary-a. Opaque, pre-darkened." },
    "secondary-b": { "stroke": { "$type": "color", "$value": "#A87A3C" }, "strokeWidth": { "$type": "dimension", "$value": 1.0 }, "fill": { "$type": "string", "$value": "none" }, "$description": "Secondary curve for primary-b in dual modes." },
    "sidechain":   { "stroke": { "$type": "color", "$value": "#A58BFF" }, "strokeAlpha": { "$type": "number", "$value": 0.7 }, "strokeWidth": { "$type": "dimension", "$value": 1.0 }, "fill": { "$type": "color", "$value": "#A58BFF" }, "fillAlpha": { "$type": "number", "$value": 0.26 }, "$description": "Sidechain reference: flat silhouette fill plus a thin dim edge. Drawn first (behind everything)." },
    "crosshair":   { "stroke": { "$type": "color", "$value": "#E8ECF3" }, "alpha": { "$type": "number", "$value": 0.35 }, "strokeWidth": { "$type": "dimension", "$value": 1.0 } },
    "marker":      { "radius": { "$type": "dimension", "$value": 3.5 }, "strokeWidth": { "$type": "dimension", "$value": 1.5 }, "fill": { "$type": "color", "$value": "#0A0D13" } }
  },
  "meter": {
    "track":       { "$type": "color", "$value": "#0A0D13" },
    "track-line":  { "$type": "color", "$value": "#1A2231", "$description": "Faint horizontal line across tracks at each labelled tick" },
    "safe":        { "$type": "color", "$value": "#34C6A8" },
    "warm":        { "$type": "color", "$value": "#EAC75A" },
    "hot":         { "$type": "color", "$value": "#FF8A3D" },
    "clip":        { "$type": "color", "$value": "#FF4F64" },
    "safe-peak":   { "$type": "color", "$value": "#217365", "$description": "safe at 55 % over track, pre-blended" },
    "warm-peak":   { "$type": "color", "$value": "#857339" },
    "hot-peak":    { "$type": "color", "$value": "#91522A" },
    "hold-tick":   { "$type": "color", "$value": "#E8ECF3" },
    "lamp-off":    { "$type": "color", "$value": "#1A2130" },
    "corr-positive": { "$type": "color", "$value": "#34C6A8" },
    "corr-negative": { "$type": "color", "$value": "#FF8A3D" },
    "rangeDbfs":   { "$type": "number", "$value": [-60, 6], "$description": "Bar geometry in dBFS for every scale" },
    "zonesDbfs":   { "$type": "number", "$value": { "warmFrom": -12, "hotFrom": -3 }, "$description": "dBFS scale zone thresholds (display value)" },
    "zonesK":      { "$type": "number", "$value": { "warmFrom": 0, "hotFrom": 4 }, "$description": "K-20/K-14/K-12 zone thresholds in K units" },
    "kReference":  { "$type": "number", "$value": { "K-20": 20, "K-14": 14, "K-12": 12 } },
    "aes17OffsetDb": { "$type": "number", "$value": 3.0103 },
    "peakFallDbPerS": { "$type": "number", "$value": 20 },
    "peakHoldMs":  { "$type": "duration", "$value": 1500 },
    "holdFallDbPerS": { "$type": "number", "$value": 30 },
    "corrDisplayTauMs": { "$type": "duration", "$value": 50 },
    "numericRefreshHz": { "$type": "number", "$value": 10 },
    "staleAfterMs": { "$type": "duration", "$value": 250 }
  },
  "font": {
    "family-ui":   { "$type": "fontFamily", "$value": "Inter", "fallback": "Segoe UI", "license": "SIL OFL 1.1 (approved T-022)", "version": "v4.1", "files": ["third_party/fonts/Inter-Medium.ttf", "third_party/fonts/Inter-SemiBold.ttf"], "binaryData": ["InterMedium_ttf", "InterSemiBold_ttf"], "$description": "Downloaded by T-021 into third_party/fonts/ and compiled into InvestigateAssets (not in assets/ui/)" },
    "family-mono": { "$type": "fontFamily", "$value": "JetBrains Mono", "fallback": "Consolas", "license": "SIL OFL 1.1 (approved T-022)", "version": "v2.304", "files": ["third_party/fonts/JetBrainsMono-Regular.ttf", "third_party/fonts/JetBrainsMono-Medium.ttf"], "binaryData": ["JetBrainsMonoRegular_ttf", "JetBrainsMonoMedium_ttf"], "$description": "Downloaded by T-021 into third_party/fonts/ and compiled into InvestigateAssets (not in assets/ui/)" }
  },
  "type": {
    "caps":        { "$type": "typography", "$value": { "fontFamily": "Inter", "fontSize": 10, "fontWeight": 600, "lineHeight": 12, "letterSpacing": 0.06, "textTransform": "uppercase" }, "$description": "Chip labels, section titles, table header, channel letters" },
    "body-sm":     { "$type": "typography", "$value": { "fontFamily": "Inter", "fontSize": 11, "fontWeight": 500, "lineHeight": 14 }, "$description": "Legend, row labels, tooltips, toasts" },
    "body":        { "$type": "typography", "$value": { "fontFamily": "Inter", "fontSize": 12, "fontWeight": 500, "lineHeight": 16 }, "$description": "Buttons, segmented control, popover rows" },
    "choice":      { "$type": "typography", "$value": { "fontFamily": "Inter", "fontSize": 13, "fontWeight": 500, "lineHeight": 16 }, "$description": "Choice values in chips" },
    "value":       { "$type": "typography", "$value": { "fontFamily": "JetBrains Mono", "fontSize": 13, "fontWeight": 500, "lineHeight": 16 }, "$description": "Numeric values in chips" },
    "unit":        { "$type": "typography", "$value": { "fontFamily": "Inter", "fontSize": 10, "fontWeight": 500, "lineHeight": 12 }, "$description": "Unit suffix after numeric values" },
    "readout":     { "$type": "typography", "$value": { "fontFamily": "JetBrains Mono", "fontSize": 12, "fontWeight": 400, "lineHeight": 16 }, "$description": "Meter table values, correlation value, hover rows" },
    "readout-lg":  { "$type": "typography", "$value": { "fontFamily": "JetBrains Mono", "fontSize": 18, "fontWeight": 500, "lineHeight": 22 }, "$description": "Loudness M, S, I" },
    "readout-hover": { "$type": "typography", "$value": { "fontFamily": "JetBrains Mono", "fontSize": 15, "fontWeight": 500, "lineHeight": 18 }, "$description": "Hover frequency" },
    "axis":        { "$type": "typography", "$value": { "fontFamily": "JetBrains Mono", "fontSize": 11, "fontWeight": 400, "lineHeight": 12 }, "$description": "Spectrum axis labels" },
    "axis-meter":  { "$type": "typography", "$value": { "fontFamily": "JetBrains Mono", "fontSize": 10, "fontWeight": 400, "lineHeight": 12 }, "$description": "Meter scale labels" }
  },
  "space": {
    "0": { "$type": "dimension", "$value": 0 },
    "1": { "$type": "dimension", "$value": 2 },
    "2": { "$type": "dimension", "$value": 4 },
    "3": { "$type": "dimension", "$value": 6 },
    "4": { "$type": "dimension", "$value": 8 },
    "5": { "$type": "dimension", "$value": 12 },
    "6": { "$type": "dimension", "$value": 16 },
    "7": { "$type": "dimension", "$value": 20 },
    "8": { "$type": "dimension", "$value": 24 },
    "9": { "$type": "dimension", "$value": 32 }
  },
  "radius": {
    "bar":     { "$type": "dimension", "$value": 2 },
    "small":   { "$type": "dimension", "$value": 4 },
    "control": { "$type": "dimension", "$value": 6 },
    "popover": { "$type": "dimension", "$value": 8 }
  },
  "stroke": {
    "hairline": { "$type": "dimension", "$value": 1 },
    "focus":    { "$type": "dimension", "$value": 2 },
    "holdTick": { "$type": "dimension", "$value": 2 }
  },
  "shadow": {
    "popover": { "$type": "shadow", "$value": { "offsetX": 0, "offsetY": 8, "blur": 24, "color": "#000000", "alpha": 0.5 }, "$description": "Only shadow in the UI; render once into a cached image when the popover opens" }
  },
  "motion": {
    "clickDeferMs":      { "$type": "duration", "$value": 250, "$description": "Delay before a single click opens a menu or text entry, so a double-click can reset instead" },
    "tooltipDelayMs":    { "$type": "duration", "$value": 700 },
    "toastCopyMs":       { "$type": "duration", "$value": 1200 },
    "toastResetMs":      { "$type": "duration", "$value": 900 },
    "toastFadeMs":       { "$type": "duration", "$value": 200 },
    "externalChangeDotMs": { "$type": "duration", "$value": 600 },
    "errorFlashMs":      { "$type": "duration", "$value": 300 }
  },
  "layout": {
    "editorDefault": { "$type": "dimension", "$value": [1200, 700] },
    "editorMin":     { "$type": "dimension", "$value": [920, 540] },
    "editorMax":     { "$type": "dimension", "$value": [2560, 1600] },
    "headerH":       { "$type": "dimension", "$value": 44 },
    "footerH":       { "$type": "dimension", "$value": 56 },
    "meterStripW":   { "$type": "dimension", "$value": 296 },
    "plotGutter":    { "$type": "dimension", "$value": { "left": 48, "right": 16, "top": 12, "bottom": 24 } },
    "chipH":         { "$type": "dimension", "$value": 40 },
    "inlineChipH":   { "$type": "dimension", "$value": 28 },
    "resizeGrip":    { "$type": "dimension", "$value": 12 },
    "buttonH":       { "$type": "dimension", "$value": 28 },
    "chipW": { "$type": "dimension", "$value": { "fftSize": 60, "overlap": 68, "window": 76, "avgTime": 72, "smoothing": 68, "slope": 92, "secondary": 96, "freqRange": 140, "dbRange": 120 } },
    "chipPadding":   { "$type": "dimension", "$value": { "x": 8, "top": 5 } },
    "footerGroupW":  { "$type": "dimension", "$value": { "analysis": 376, "display": 196, "range": 268 } },
    "chipGap":       { "$type": "dimension", "$value": 8 },
    "groupGap":      { "$type": "dimension", "$value": 20 },
    "dragPixelsFullRange": { "$type": "number", "$value": 240 },
    "fineFactor":    { "$type": "number", "$value": 0.1 },
    "choiceDragPixelsPerStep": { "$type": "number", "$value": 20 },
    "choiceDragPixelsPerStepFine": { "$type": "number", "$value": 60 },
    "clickSlopPx":   { "$type": "number", "$value": 4 },
    "minDbGridPx":   { "$type": "number", "$value": 20 },
    "minFreqLabelGapPx": { "$type": "number", "$value": 36 },
    "minMinorGridPx": { "$type": "number", "$value": 4 }
  },
  "zoom": {
    "$description": "T-034, ui-spec 5.9. Every alpha colour is drawn as one fillRectList (no layers). Values reuse the palette except overview-fill.",
    "panel-fill":        { "$type": "color", "$value": "#151B27", "$description": "Zoom panel fill, opaque (same value as color.card)" },
    "panel-border":      { "$type": "color", "$value": "#2A3447", "$description": "Zoom panel 1 px border, overview strip 1 px frame, Fit button border (color.border)" },
    "range-text-zoomed": { "$type": "color", "$value": "#E8ECF3", "$description": "Range text of an axis that is zoomed (text-primary), 14.6:1 on panel-fill" },
    "range-text-full":   { "$type": "color", "$value": "#A3AEC2", "$description": "Range text of an axis at its home range, Fit label (text-secondary), 7.7:1 on panel-fill" },
    "bin-hint-text":     { "$type": "color", "$value": "#EAC75A", "$description": "Bin-spacing hint (state-warn), 10.5:1 on panel-fill" },
    "fit-hover-fill":    { "$type": "color", "$value": "#232C3E", "$description": "Fit button hover and pressed fill (surface-3)" },
    "fit-pressed":       { "$type": "color", "$value": "#62D6F0", "$description": "Fit button pressed border and text (accent), 8.3:1 on surface-3" },
    "overview-bg":       { "$type": "color", "$value": "#0A0D13", "$description": "Overview strip background (bg-plot)" },
    "overview-fill":     { "$type": "color", "$value": "#1C353F", "$description": "Overview curve body, one bar per physical column: accent 20 % over bg-plot, pre-blended. Decorative (1.5:1), always paired with overview-line" },
    "overview-line":     { "$type": "color", "$value": "#3E8FA3", "$description": "Overview curve top line, 1 physical px rects, 5.2:1 on overview-bg" },
    "overview-shade":    { "$type": "color", "$value": "#0A0D13", "alpha": { "$type": "number", "$value": 0.6 }, "$description": "Dims the strip outside the view window (up to 4 rects)" },
    "window-stroke":     { "$type": "color", "$value": "#62D6F0", "$description": "View window outline, 1 px (accent), 11.5:1 on overview-bg" },
    "window-fill-hover": { "$type": "color", "$value": "#62D6F0", "alpha": { "$type": "number", "$value": 0.12 }, "$description": "Inside the window while the pointer is over its hit area" },
    "window-fill-drag":  { "$type": "color", "$value": "#62D6F0", "alpha": { "$type": "number", "$value": 0.20 }, "$description": "Inside the window while it is dragged" },
    "window-ghost":      { "$type": "color", "$value": "#75829A", "$description": "1 px outline of the window a press would centre (text-tertiary), 5.0:1 on overview-bg" },
    "box-stroke":        { "$type": "color", "$value": "#E8ECF3", "$description": "Box-zoom rubber band outline, 1 px (text-primary), 16.4:1 on bg-plot" },
    "box-fill":          { "$type": "color", "$value": "#E8ECF3", "alpha": { "$type": "number", "$value": 0.08 }, "$description": "Box-zoom rubber band fill" },
    "box-target":        { "$type": "color", "$value": "#75829A", "$description": "1 px outline of the widened result when a box axis is below its minimum span (text-tertiary)" }
  },
  "zoomLayout": {
    "$description": "Zoom panel geometry (ui-spec 5.9.6). Panel x = data.right - insetRight - width, y = data.y + insetTop, width = clamp(round(data.w * widthRatio), minW, maxW). Rects are panel-relative.",
    "insetRight":   { "$type": "dimension", "$value": 8 },
    "insetTop":     { "$type": "dimension", "$value": 8 },
    "widthRatio":   { "$type": "number", "$value": 0.25 },
    "minW":         { "$type": "dimension", "$value": 200 },
    "maxW":         { "$type": "dimension", "$value": 280 },
    "height":       { "$type": "dimension", "$value": 92, "$description": "108 while the bin-spacing row shows" },
    "radius":       { "$type": "dimension", "$value": 6 },
    "textX":        { "$type": "dimension", "$value": 8 },
    "row1":         { "$type": "dimension", "$value": { "y": 6, "h": 16, "wFromPanel": -60 }, "$description": "Frequency range text: (8, 6, W - 60, 16)" },
    "row2":         { "$type": "dimension", "$value": { "y": 26, "h": 16, "wFromPanel": -16 }, "$description": "Level range text: (8, 26, W - 16, 16)" },
    "row3":         { "$type": "dimension", "$value": { "y": 42, "h": 16, "wFromPanel": -16 }, "$description": "Bin-spacing hint, only below binHintBins: (8, 42, W - 16, 16)" },
    "fitButton":    { "$type": "dimension", "$value": { "xFromRight": 44, "y": 2, "w": 40, "h": 24, "radius": 4 } },
    "strip":        { "$type": "dimension", "$value": { "x": 6, "gapBelowRows": 4, "wFromPanel": -12, "h": 40, "bottomPad": 6, "frame": 1 }, "$description": "Overview strip: (6, 46, W - 12, 40), or y 62 with the bin row" },
    "windowMinPx":  { "$type": "dimension", "$value": 6, "$description": "Visual minimum of the view-window rectangle per axis" },
    "windowHitMinPx": { "$type": "dimension", "$value": 16, "$description": "Minimum hit area of the view-window rectangle per axis" },
    "hoverCardExclusion": { "$type": "dimension", "$value": 4, "$description": "The hover card avoids the panel bounds inflated by this much" },
    "toastClearance": { "$type": "dimension", "$value": 8, "$description": "A centred toast ends at least this far left of the panel" }
  },
  "zoomInteraction": {
    "$description": "ui-spec 5.9.2 and 5.9.3.",
    "notchFactor":        { "$type": "number", "$value": 0.8, "$description": "Span factor per wheel notch zooming in; out is 1 / 0.8 = 1.25" },
    "fineFactor":         { "$type": "number", "$value": 0.95, "$description": "With Shift; out is 1 / 0.95" },
    "juceDeltaPerNotch":  { "$type": "number", "$value": 0.234375, "$description": "MouseWheelDetails delta JUCE reports on Windows for one 120-unit notch (60 / 256)" },
    "browserPxPerNotch":  { "$type": "number", "$value": 100, "$description": "Mockup only: WheelEvent deltaMode 0; deltaMode 1 uses 3 lines per notch" },
    "maxNotchesPerEvent": { "$type": "number", "$value": 3 },
    "minViewSpanOctaves": { "$type": "number", "$value": 0.16666667, "$description": "1/6 octave, DisplayRange.h minViewSpanOctaves" },
    "minViewSpanDb":      { "$type": "number", "$value": 6, "$description": "DisplayRange.h minViewSpanDb" },
    "dragThresholdPx":    { "$type": "number", "$value": 4, "$description": "Euclidean distance from the press point; same as layout.clickSlopPx" },
    "clickDeferMs":       { "$type": "duration", "$value": 250, "$description": "Click-to-reset defer; same as motion.clickDeferMs" },
    "boxCancelPx":        { "$type": "number", "$value": 4, "$description": "A box narrower or lower than this at release cancels" },
    "horizontalPanPerNotch": { "$type": "number", "$value": 0.10, "$description": "Fraction of the visible log-frequency span per horizontal notch" },
    "binHintBins":        { "$type": "number", "$value": 16, "$description": "Show the bin spacing when fewer bins than this lie in the visible span" },
    "hoverSigFigsZoomed": { "$type": "number", "$value": 4, "$description": "Hover and clipboard frequency precision while the visible span is below hoverPrecisionOctaves" },
    "hoverPrecisionOctaves": { "$type": "number", "$value": 1 },
    "gridIdleRebuildMs":  { "$type": "duration", "$value": 200, "$description": "Rebuild the cached grid image after the view has been still this long" },
    "labelCacheEntries":  { "$type": "number", "$value": 128 },
    "maxNewLabelsPerFrame": { "$type": "number", "$value": 16 },
    "viewEpsilonLn":      { "$type": "number", "$value": 1e-6, "$description": "A frequency edge within this (natural log) of home counts as at home" },
    "viewEpsilonDb":      { "$type": "number", "$value": 1e-4 }
  },
  "deepGrid": {
    "$description": "ui-spec 5.9.8. Extends layout.minFreqLabelGapPx and layout.minDbGridPx.",
    "freqLabelGapRule":   { "$type": "string", "$value": "G = max(36, axisCharAdvancePx * longestLabelChars + labelPaddingPx)" },
    "axisCharAdvancePx":  { "$type": "number", "$value": 6.6, "$description": "JetBrains Mono 11 px advance (0.6 em)" },
    "labelPaddingPx":     { "$type": "number", "$value": 16 },
    "labelEdgePx":        { "$type": "number", "$value": 2 },
    "freqDecadeSets":     { "$type": "number", "$value": [[1, 2, 3, 5, 7], [1, 2, 5], [1]] },
    "freqLinearMantissas": { "$type": "number", "$value": [1, 2, 5] },
    "freqMaxMultiplesPerStep": { "$type": "number", "$value": 400 },
    "halfStepMinPx":      { "$type": "number", "$value": 16 },
    "dbSteps":            { "$type": "number", "$value": [0.1, 0.2, 0.5, 1, 2, 3, 6, 12, 24] },
    "dbStepMinPx":        { "$type": "number", "$value": 20 }
  },
  "cursor": {
    "$description": "Custom cursors (ui-spec 5.9.4). Fixed black and white, not recoloured. Render at 24 px x display scale.",
    "hand-open": { "$type": "string", "$value": "assets/ui/cursor-hand-open.svg", "hotspot": [12, 12] },
    "hand-grab": { "$type": "string", "$value": "assets/ui/cursor-hand-grab.svg", "hotspot": [12, 12] },
    "zoom-box":  { "$type": "string", "$value": "assets/ui/cursor-zoom-box.svg", "hotspot": [7.5, 7.5] }
  }
}
